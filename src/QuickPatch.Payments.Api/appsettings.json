{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Payments": ""
  },
  "Jwt": {
    "Issuer": "quickpatch-identity",
    "Audience": "quickpatch",
    "PublicKeyPem": ""
  },
  "Kafka": {
    "BootstrapServers": "",
    "ConsumerGroupId": "payments-service"
  },
  "Outbox": {
    "PublisherRole": "payments_outbox",
    "BatchSize": 50,
    "PollInterval": "00:00:01"
  },
  "Reconciliation": {
    "SchedulerRole": "payments_scheduler",
    "Interval": "00:00:30",
    "MinimumAge": "00:00:30",
    "OrphanAge": "00:05:00"
  }
}
